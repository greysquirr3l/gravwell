  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "Rust Keywords",
        "scope": ["keyword.control.rust", "keyword.other.rust", "storage.type.rust", "storage.modifier.rust"],
        "settings": {
          "foreground": "#ce9178",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Rust Types",
        "scope": ["entity.name.type.rust", "support.type.primitive.rust", "entity.name.type.primitive.rust"],
        "settings": {
          "foreground": "#4ec9b0",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Rust Functions and Macros",
        "scope": ["entity.name.function.rust", "support.function.rust", "entity.name.function.macro.rust"],
        "settings": {
          "foreground": "#dcdcaa",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Rust Strings",
        "scope": ["string.quoted.double.rust", "string.quoted.single.rust"],
        "settings": {
          "foreground": "#ce9178"
        }
      },
      {
        "name": "Rust Numbers",
        "scope": ["constant.numeric.rust"],
        "settings": {
          "foreground": "#b5cea8"
        }
      },
      {
        "name": "Rust Comments",
        "scope": ["comment.line.double-slash.rust", "comment.block.rust"],
        "settings": {
          "foreground": "#6a9955",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Rust Module Names",
        "scope": ["entity.name.namespace.rust"],
        "settings": {
          "foreground": "#4fc1ff",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Rust Constants",
        "scope": ["constant.other.rust", "variable.other.constant.rust"],
        "settings": {
          "foreground": "#4fc1ff",
          "fontStyle": "bold"
        }
      },
      {
        "name": "Rust Operators",
        "scope": ["keyword.operator.rust"],
        "settings": {
          "foreground": "#d4d4d4"
        }
      },
      {
        "name": "Rust Struct Fields",
        "scope": ["variable.other.member.rust"],
        "settings": {
          "foreground": "#9cdcfe"
        }
      },
      {
        "name": "Rust Lifetime",
        "scope": ["storage.modifier.lifetime.rust", "entity.name.type.lifetime.rust"],
        "settings": {
          "foreground": "#4ec9b0",
          "fontStyle": "italic"
        }
      },
      {
        "name": "Rust Attributes",
        "scope": ["meta.attribute.rust"],
        "settings": {
          "foreground": "#4fc1ff"
        }
      }
    ]
  },

  "editor.semanticTokenColorCustomizations": {

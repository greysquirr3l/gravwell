###################
# Test outputs
test_results/
coverage/
tarpaulin-report.html
cobertura.xml
lcov.info

# Property-based test artifacts
proptest-regressions/
.proptest_cache/

###################
# Documentation
###################
# mdBook
book/
**/book/

# Generated documentation
doc/
docs/_build/
site/

